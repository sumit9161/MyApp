// File: Jenkinsfile (on main branch)
pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo "Building MAIN branch..."
                sh 'echo "Compiling code for MAIN"'
            }
        }
        stage('Unit Test') {
            steps {
                echo "Running unit tests on MAIN branch..."
                sh 'echo "Executing MAIN unit tests"'
            }
        }
        stage('Integration Test') {
            steps {
                echo "Running integration tests on MAIN branch..."
                sh 'echo "Executing MAIN integration tests"'
            }
        }
        stage('Deploy to Production') {
            steps {
                echo "Deploying to Production server..."
                sh 'echo "Deploying MAIN branch to Production"'
            }
        }
    }
    post {
        always {
            echo "MAIN branch pipeline finished."
        }
    }
}
